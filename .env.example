# payment-service-cinema — copia este archivo como .env (local) y .env.production (Render).
# Ninguno de los dos se commitea (.gitignore).

# ── Base propia: cinema_payments (historial de pagos) ─────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/cinema_payments
# true: aplica las migraciones de Alembic al arrancar (cada una corre una sola vez).
MIGRATE_ON_START=true

# ── Autenticación ─────────────────────────────────────────────────────────────
# Mismo JWT_SECRET que auth-service: identifica a quien consulta sus pagos.
JWT_SECRET=
JWT_ALGORITHM=HS256
# Redis compartido con auth-service (blacklist de tokens tras logout).
REDIS_URL=redis://redis:6379
# Orígenes del frontend (coma entre cada uno). En local, lvh.me (Wompi no acepta localhost).
CORS_ORIGINS=http://lvh.me:5173

# Mismo valor que en booking-service: protege /internal/* (reembolsos).
INTERNAL_SERVICE_TOKEN=

# ── Kafka (Confluent Cloud) ───────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
# Dev y prod comparten el cluster: en local usa SIEMPRE un sufijo distinto.
KAFKA_GROUP_ID=payment-service-group-local

# ── Wompi (comercios.wompi.co → Desarrolladores) ──────────────────────────────
# Sandbox: pub_test_ / prv_test_ / test_integrity_ / test_events_ y la API de sandbox.
WOMPI_PUBLIC_KEY=
# Consultar y anular transacciones exige la llave privada.
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_TIMEOUT_SECONDS=8

# ── Pagos ─────────────────────────────────────────────────────────────────────
# Página del frontend a la que vuelve Wompi. Wompi no acepta localhost: en local, lvh.me.
PAYMENTS_REDIRECT_URL=http://lvh.me:5173/pago/resultado
# Referencias: <prefijo>-<uuid>
PAYMENTS_REFERENCE_PREFIX=cinemaplus
PAYMENTS_CURRENCY=COP
# Minutos para pagar el enlace de una recarga Cinema+ (el de boletas lo fija booking-service).
RECHARGE_CHECKOUT_TTL_MINUTES=30
RECHARGE_MIN_AMOUNT=10000
RECHARGE_MAX_AMOUNT=1000000
# Cada cuánto se consultan en Wompi los pagos pendientes, y cuánto después de vencer.
PAYMENTS_RECONCILE_INTERVAL_SECONDS=60
PAYMENTS_RECONCILE_GRACE_MINUTES=30
